# ==========================================================
# Application
# ==========================================================

APP_NAME=AI Knowledge Platform
APP_VERSION=0.1.0
APP_DESCRIPTION=Production-grade AI Knowledge Platform API

# ==========================================================
# PostgreSQL
# ==========================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=ai_knowledge_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Automated migration tests (dedicated disposable database)
MIGRATION_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:15432/ai_knowledge_platform_migration_ci_test

# ==========================================================
# Authentication
# ==========================================================

JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem


# ==========================================================
# Document Processing Worker
# ==========================================================

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_RECOVERY_INTERVAL_SECONDS=60
WORKER_STALE_TIMEOUT_SECONDS=900
